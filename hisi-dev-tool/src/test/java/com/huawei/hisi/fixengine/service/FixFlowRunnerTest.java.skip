package com.huawei.hisi.fixengine.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.huawei.hisi.fixengine.executor.MavenExecutor;
import com.huawei.hisi.fixengine.executor.TestRunResult;
import com.huawei.hisi.fixengine.model.FixSession;
import com.huawei.hisi.fixengine.model.TestGenInput;
import com.huawei.hisi.fixengine.repository.FixSessionRepository;
import com.huawei.hisi.loganalysis.orchestrator.LogAnalysisDagOrchestrator;
import com.huawei.hisi.ram.chat.RamChatWebSocketHandler;
import com.huawei.hisi.ram.model.AgentEvent;
import com.huawei.hisi.ram.model.EventType;
import com.huawei.hisi.ram.repository.AgentEventRepository;
import com.huawei.hisi.repository.LogAnalysisRepository;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.Collections;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.function.Function;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

/**
 * Baseline tests for {@link FixFlowRunner} — documents current behavior BEFORE refactoring.
 *
 * <p>All external dependencies are mocked. Tests use reflection to access private
 * methods to document their current contracts. No {@code @SpringBootTest} is used.
 *
 * <p>Known issues documented here:
 * <ul>
 *   <li><b>P0-5</b>: {@code extractTestClassName} always returns {@code "ReproTest"}
 *       regardless of input — hardcoded placeholder that ignores the test method signature.</li>
 *   <li><b>Step 2</b>: KG search is a no-op placeholder that passes throwPointSig through unchanged.</li>
 *   <li>Lenient policy: build/repro/pass failures produce {@code SUCCESS_UNVERIFIED} not {@code ERROR}.</li>
 * </ul>
 */
@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
@DisplayName("FixFlowRunner")
class FixFlowRunnerTest {

    @Mock
    private LogAnalysisDagOrchestrator logOrch;
    @Mock
    private WorktreeService wtSvc;
    @Mock
    private TestGenService tgSvc;
    @Mock
    private ReproService repSvc;
    @Mock
    private FixService fixSvc;
    @Mock
    private MavenExecutor mvnExec;
    @Mock
    private FixSessionRepository fixRepo;
    @Mock
    private RamChatWebSocketHandler ws;
    @Mock
    private LogAnalysisRepository logRepo;
    @Mock
    private AgentEventRepository evtRepo;

    private final ObjectMapper objectMapper = new ObjectMapper();

    private FixFlowRunner runner;

    @BeforeEach
    void setUp() {
        runner = new FixFlowRunner(logOrch, wtSvc, tgSvc, repSvc, fixSvc, mvnExec,
                fixRepo, ws, logRepo, evtRepo, objectMapper);
        lenient().when(evtRepo.append(any())).thenAnswer(inv -> inv.getArgument(0));
        lenient().when(fixRepo.update(any())).thenReturn(1);
    }

    @AfterEach
    void tearDown() {
        System.clearProperty("hisi.fix.repo-path");
    }

    // ===================================================================
    // Helper: set currentReportId via reflection (needed for multi-repo
    // resolution in stepLogRecognition).
    // ===================================================================

    private void injectReportId(FixFlowRunner r, String reportId) {
        try {
            Field f = FixFlowRunner.class.getDeclaredField("currentReportId");
            f.setAccessible(true);
            f.set(r, reportId);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    // ===================================================================
    // Session + standard mock factory helpers
    // ===================================================================

    private FixSession session(String reportId, String chatSessionId, String branchName) {
        long now = System.currentTimeMillis() / 1000L;
        return FixSession.builder()
                .id("fix-" + reportId)
                .reportId(reportId)
                .chatSessionId(chatSessionId)
                .status("RUNNING")
                .branchName(branchName)
                .errorMsg("NullPointerException: something went wrong")
                .throwPointSig("com.foo.Bar.do")
                .tenantId("default")
                .createBy("system")
                .delFlag(0)
                .createdAt(now)
                .updatedAt(now)
                .build();
    }

    /** Set up a LogAnalysisReportEntity with projectPath and stackTrace. */
    @SuppressWarnings("unchecked")
    private void setupReport(String reportId) {
        LogAnalysisRepository.LogAnalysisReportEntity report =
                new LogAnalysisRepository.LogAnalysisReportEntity();
        report.setId(100L);
        Map<String, Object> queryParams = Map.of("projectPath", "/repo");
        report.setQueryParams(queryParams);
        report.setLogStackTrace("at com.foo.Bar.do(Bar.java:10)");
        when(logRepo.findById(Long.parseLong(reportId))).thenReturn(report);
    }

    /**
     * Wire up the full happy-path mock chain so {@code runner.run()} completes all 9 steps.
     */
    @SuppressWarnings("unchecked")
    private void setupHappyPath(FixSession s) {
        setupReport(s.getReportId());

        // Step 1: log analysis DAG returns extracted exception info
        Map<String, Object> dagOutput = new LinkedHashMap<>();
        dagOutput.put("parsedError", Map.of("errorType", "NullPointerException"));
        dagOutput.put("keyFrames", List.of(Map.of("fullSignature", "com.foo.Bar.do")));
        dagOutput.put("exceptionMessage", "something went wrong");
        dagOutput.put("projectPath", "/repo");
        try {
            when(logOrch.analyzeLog(anyString(), any(), anyString(), any(), any()))
                    .thenReturn(dagOutput);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }

        // Step 3: worktree
        when(wtSvc.currentBranch(anyString())).thenReturn("master");
        when(wtSvc.createWorktree(anyString(), anyString(), anyString()))
                .thenReturn("/tmp/wt/" + s.getBranchName());

        // Step 4: test generation with compileCheck callback
        when(tgSvc.generate(any(TestGenInput.class), any()))
                .thenAnswer(inv -> {
                    Function<String, String> compileCheck = inv.getArgument(1);
                    compileCheck.apply("generatedCode");
                    return "generatedCode";
                });

        // Maven executor (for compile check in step 4)
        when(mvnExec.runTest(anyString(), anyString(), any()))
                .thenReturn(new TestRunResult(0, "OK"));

        // Step 5: repro succeeds
        when(repSvc.runAndCheckRepro(anyString(), anyString(), anyString(), any(), anyInt()))
                .thenReturn(true);

        // Step 6: AI fix
        when(fixSvc.fix(anyString(), anyString(), anyString(), anyString(), anyString()))
                .thenReturn("class Fixed { void do() { /* fixed */ } }");

        // Step 7: pass check
        when(repSvc.runAndCheckPass(anyString(), anyString()))
                .thenReturn(true);

        // Step 8: commit
        when(wtSvc.commit(anyString(), anyString(), anyString()))
                .thenReturn("abc123def");
    }

    // ===================================================================
    // 1. extractTestClassName — documents P0-5 hardcoded behavior
    // ===================================================================

    @Nested
    @DisplayName("extractTestClassName")
    class ExtractTestClassNameTests {

        @Test
        @DisplayName("derives class name from testMethodName (P0-5: fixed hardcoded placeholder)")
        void derivesFromTestMethodName() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractTestClassName", TestGenInput.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null,
                    TestGenInput.builder()
                            .testMethodSignature("com.foo.Bar.do")
                            .testMethodName("testDoNullPointerException")
                            .build());

            assertThat(result).isEqualTo("DoNullPointerExceptionTest");
        }

        @Test
        @DisplayName("derives class name from exotic input signature")
        void derivesFromExoticInput() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractTestClassName", TestGenInput.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null,
                    TestGenInput.builder()
                            .testMethodSignature("org.example.Deeply.Nested.Class.call")
                            .testMethodName("testCallIllegalArgumentException")
                            .build());

            assertThat(result).isEqualTo("CallIllegalArgumentExceptionTest");
        }
    }

    // ===================================================================
    // 2. sigToFilePath
    // ===================================================================

    @Nested
    @DisplayName("sigToFilePath")
    class SigToFilePathTests {

        @Test
        @DisplayName("converts 'com.foo.MyClass' to 'src/main/java/com/foo/MyClass.java'")
        void convertsFqnToFilePath() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("sigToFilePath", String.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null, "com.foo.MyClass.methodName");

            assertThat(result).isEqualTo("src/main/java/com/foo/MyClass.java");
        }

        @Test
        @DisplayName("returns unknown path for null input")
        void returnsUnknownForNull() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("sigToFilePath", String.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null, (Object) null);

            assertThat(result).isEqualTo("src/main/java/Unknown.java");
        }

        @Test
        @DisplayName("returns unknown path for single-segment input (no dot)")
        void returnsUnknownForSingleSegment() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("sigToFilePath", String.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null, "Bar");

            assertThat(result).isEqualTo("src/main/java/Unknown.java");
        }

        @Test
        @DisplayName("handles nested packages")
        void handlesNestedPackages() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("sigToFilePath", String.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null, "com.huawei.hisi.deep.nested.Util.helper");

            assertThat(result).isEqualTo("src/main/java/com/huawei/hisi/deep/nested/Util.java");
        }
    }

    // ===================================================================
    // 3. flattenDagOutputs — extracts exceptionType and throwPointSig
    //    from nested DAG output
    // ===================================================================

    @Nested
    @DisplayName("flattenDagOutputs")
    class FlattenDagOutputsTests {

        @Test
        @DisplayName("extracts exceptionType from parsedError.errorType")
        void extractsExceptionType() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            dagOutput.put("parsedError", Map.of("errorType", "NullPointerException"));
            dagOutput.put("keyFrames", List.of(Map.of("fullSignature", "com.foo.Bar.do")));

            m.invoke(runner, dagOutput);

            assertThat(dagOutput).containsEntry("exceptionType", "NullPointerException");
            assertThat(dagOutput).containsEntry("throwPointSig", "com.foo.Bar.do");
        }

        @Test
        @DisplayName("does not overwrite existing exceptionType")
        void doesNotOverwriteExistingExceptionType() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            dagOutput.put("exceptionType", "AlreadySet");
            dagOutput.put("parsedError", Map.of("errorType", "DifferentException"));

            m.invoke(runner, dagOutput);

            assertThat(dagOutput.get("exceptionType")).isEqualTo("AlreadySet");
        }

        @Test
        @DisplayName("skips exceptionType when errorType is 'Unknown'")
        void skipsUnknownErrorType() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            dagOutput.put("parsedError", Map.of("errorType", "Unknown"));

            m.invoke(runner, dagOutput);

            assertThat(dagOutput).doesNotContainKey("exceptionType");
        }

        @Test
        @DisplayName("skips throwPointSig when keyFrames is empty list")
        void skipsEmptyKeyFrames() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            dagOutput.put("keyFrames", Collections.emptyList());

            m.invoke(runner, dagOutput);

            assertThat(dagOutput).doesNotContainKey("throwPointSig");
        }

        @Test
        @DisplayName("skips throwPointSig when keyFrames entry lacks fullSignature")
        void skipsMissingFullSignature() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            dagOutput.put("keyFrames", List.of(Map.of("className", "SomeClass")));

            m.invoke(runner, dagOutput);

            assertThat(dagOutput).doesNotContainKey("throwPointSig");
        }

        @Test
        @DisplayName("gracefully handles null parsedError and keyFrames")
        void gracefullyHandlesNullFields() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("flattenDagOutputs", Map.class);
            m.setAccessible(true);

            Map<String, Object> dagOutput = new LinkedHashMap<>();
            // No parsedError, no keyFrames — should not throw
            m.invoke(runner, dagOutput);

            assertThat(dagOutput).doesNotContainKey("exceptionType");
            assertThat(dagOutput).doesNotContainKey("throwPointSig");
        }
    }

    // ===================================================================
    // 4. Step 2: KG search is a placeholder
    // ===================================================================

    @Nested
    @DisplayName("Step 2: KG search (placeholder)")
    class Step2KgSearchTests {

        @Test
        @DisplayName("step 2 is a no-op placeholder that logs a TODO but does not call any KG API")
        void kgSearchIsPlaceholder() {
            FixSession s = session("100", "42", "fix/100-a");
            setupHappyPath(s);

            runner.run(s);

            // The LogAnalysisDagOrchestrator is ONLY called once (step 1), not again in step 2.
            // No external KG service is invoked for step 2.
            try {
                verify(logOrch, times(1)).analyzeLog(anyString(), any(), anyString(), any(), any());
            } catch (Exception ignored) {
                // analyzeLog declares throws Exception but the mock never throws
            }
        }
    }

    // ===================================================================
    // 5. Step 3: create_worktree delegates to WorktreeService
    // ===================================================================

    @Nested
    @DisplayName("Step 3: create_worktree")
    class Step3CreateWorktreeTests {

        @Test
        @DisplayName("step 3 delegates to WorktreeService.createWorktree with correct args")
        void step3DelegatesToWorktreeService() {
            FixSession s = session("700", "49", "fix/700-a");
            setupHappyPath(s);

            runner.run(s);

            verify(wtSvc).createWorktree(eq("fix/700-a"), eq("/repo"), eq("master"));
        }

        @Test
        @DisplayName("step 3 updates session with worktree path")
        void step3UpdatesSessionWorktreePath() {
            FixSession s = session("701", "50", "fix/701-a");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            List<FixSession> updates = captor.getAllValues();
            FixSession lastUpdate = updates.get(updates.size() - 1);
            assertThat(lastUpdate.getWorktreePath()).isNotNull();
        }
    }

    // ===================================================================
    // 6. Step 4: generate_test delegates to TestGenService
    // ===================================================================

    @Nested
    @DisplayName("Step 4: generate_test")
    class Step4GenerateTestTests {

        @Test
        @DisplayName("step 4 delegates to TestGenService.generate with compileCheck callback")
        void step4DelegatesToTestGenService() {
            FixSession s = session("800", "51", "fix/800-a");
            setupHappyPath(s);

            runner.run(s);

            verify(tgSvc).generate(any(TestGenInput.class), any());
        }

        @Test
        @DisplayName("step 4 delegates to WorktreeService.writeTestFile to persist generated test")
        void step4WritesTestFile() {
            FixSession s = session("801", "52", "fix/801-a");
            setupHappyPath(s);

            runner.run(s);

            // The test is written after generation
            verify(wtSvc, times(2)).writeTestFile(anyString(), eq("com.foo"), eq("DoNullPointerExceptionTest"), anyString());
        }
    }

    // ===================================================================
    // 7. Step 6: ai_fix delegates to FixService/FixAgent
    // ===================================================================

    @Nested
    @DisplayName("Step 6: ai_fix")
    class Step6AiFixTests {

        @Test
        @DisplayName("step 6 delegates to FixService.fix")
        void step6DelegatesToFixService() {
            FixSession s = session("900", "53", "fix/900-a");
            setupHappyPath(s);

            runner.run(s);

            verify(fixSvc).fix(eq("com.foo.Bar.do"), eq("NullPointerException"),
                    any(), anyString(), anyString());
        }

        @Test
        @DisplayName("step 6 applies the fix to the worktree via WorktreeService.applyFix")
        void step6AppliesFixToWorktree() {
            FixSession s = session("901", "54", "fix/901-a");
            setupHappyPath(s);

            runner.run(s);

