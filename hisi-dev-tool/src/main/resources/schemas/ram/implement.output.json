{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implement Stage Output",
  "type": "object",
  "required": ["biz_plan", "api_changes"],
  "properties": {
    "biz_plan": {
      "type": "object",
      "required": ["steps", "data_flow"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "data_flow": { "type": "string" },
        "acceptance_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "api_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": { "type": "string" },
          "current_behavior": { "type": "string" },
          "new_behavior": { "type": "string" },
          "method_ref": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "state_machine_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enum_type": { "type": "string" },
          "old_values": { "type": "array", "items": { "type": "string" } },
          "new_values": { "type": "array", "items": { "type": "string" } },
          "migration_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "data_model_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": { "type": "string" },
          "field": { "type": "string" },
          "change_type": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "config_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "old_value": { "type": "string" },
          "new_value": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
