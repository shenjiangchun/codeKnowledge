{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clarify Stage Input",
  "type": "object",
  "required": ["userRequirement"],
  "properties": {
    "userRequirement": {
      "type": "string",
      "description": "Raw requirement text from the user",
      "minLength": 1
    },
    "userId": {
      "type": "string"
    },
    "projectHints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
