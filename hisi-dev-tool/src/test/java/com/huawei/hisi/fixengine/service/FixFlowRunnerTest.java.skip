    // ===================================================================
    // 8. Step 8: commit delegates to WorktreeService.commit()
    // ===================================================================

    @Nested
    @DisplayName("Step 8: commit")
    class Step8CommitTests {

        @Test
        @DisplayName("step 8 delegates to WorktreeService.commit")
        void step8DelegatesToWorktreeServiceCommit() {
            FixSession s = session("1000", "55", "fix/1000-a");
            setupHappyPath(s);

            runner.run(s);

            verify(wtSvc).commit(eq("fix/1000-a"), anyString(), contains("NullPointerException"));
        }

        @Test
        @DisplayName("step 8 updates session with commit hash")
        void step8UpdatesSessionCommitHash() {
            FixSession s = session("1001", "56", "fix/1001-a");
            setupHappyPath(s);
            when(wtSvc.commit(anyString(), anyString(), anyString())).thenReturn("def456abc");

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            List<FixSession> updates = captor.getAllValues();
            FixSession lastUpdate = updates.get(updates.size() - 1);
            assertThat(lastUpdate.getCommitHash()).isEqualTo("def456abc");
        }
    }

    // ===================================================================
    // 9. Step 9: done sets session status to SUCCESS
    // ===================================================================

    @Nested
    @DisplayName("Step 9: done (status)")
    class Step9DoneTests {

        @Test
        @DisplayName("happy path sets status to SUCCESS")
        void happyPathSetsSuccess() {
            FixSession s = session("2000", "57", "fix/2000-a");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS");
        }

        @Test
        @DisplayName("final checkpoint event is emitted with summary and finalText")
        void emitsCheckpointEvent() {
            FixSession s = session("2001", "58", "fix/2001-a");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<AgentEvent> captor = ArgumentCaptor.forClass(AgentEvent.class);
            verify(evtRepo, atLeastOnce()).append(captor.capture());
            boolean hasCheckpoint = captor.getAllValues().stream()
                    .anyMatch(e -> e.getType() == EventType.CHECKPOINT);
            assertThat(hasCheckpoint).isTrue();
        }
    }

    // ===================================================================
    // 10. Lenient policy: build/repro/pass failure -> SUCCESS_UNVERIFIED
    // ===================================================================

    @Nested
    @DisplayName("Lenient policy: SUCCESS_UNVERIFIED")
    class LenientPolicyTests {

        @Test
        @DisplayName("repro failure (step 5) -> SUCCESS_UNVERIFIED, not ERROR")
        void reproFailureProducesSuccessUnverified() {
            FixSession s = session("400", "44", "fix/400-a");
            setupHappyPath(s);
            when(repSvc.runAndCheckRepro(anyString(), anyString(), anyString(), any(), anyInt()))
                    .thenReturn(false);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS_UNVERIFIED");
        }

        @Test
        @DisplayName("pass failure (step 7) -> SUCCESS_UNVERIFIED")
        void passFailureProducesSuccessUnverified() {
            FixSession s = session("300", "45", "fix/300-a");
            setupHappyPath(s);
            when(repSvc.runAndCheckPass(anyString(), anyString())).thenReturn(false);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS_UNVERIFIED");
        }

        @Test
        @DisplayName("both repro and pass failure -> SUCCESS_UNVERIFIED")
        void bothFailuresProduceSuccessUnverified() {
            FixSession s = session("500", "46", "fix/500-a");
            setupHappyPath(s);
            when(repSvc.runAndCheckRepro(anyString(), anyString(), anyString(), any(), anyInt()))
                    .thenReturn(false);
            when(repSvc.runAndCheckPass(anyString(), anyString())).thenReturn(false);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS_UNVERIFIED");
        }
    }

    // ===================================================================
    // 11. extractMethodBody
    // ===================================================================

    @Nested
    @DisplayName("extractMethodBody")
    class ExtractMethodBodyTests {

        @Test
        @DisplayName("extracts a simple public method with body")
        void extractsSimpleMethod() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractMethodBody",
                    String.class, String.class);
            m.setAccessible(true);

            String source = """
                    package com.foo;
                    public class Foo {
                        public void bar(String x) {
                            System.out.println(x);
                        }
                    }
                    """;

            String result = (String) m.invoke(null, source, "bar");

            assertThat(result).contains("public void bar(String x)");
            assertThat(result).contains("System.out.println(x)");
            assertThat(result).contains("{").contains("}");
        }

        @Test
        @DisplayName("returns '// method not found: xxx' for missing method")
        void returnsMethodNotFoundForMissingMethod() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractMethodBody",
                    String.class, String.class);
            m.setAccessible(true);

            String source = """
                    package com.foo;
                    public class Foo {
                        public void bar(String x) {
                            System.out.println(x);
                        }
                    }
                    """;

            String result = (String) m.invoke(null, source, "baz");

            assertThat(result).isEqualTo("// method not found: baz");
        }

        @Test
        @DisplayName("extracts method with multiple lines and braces")
        void extractsMultiLineMethod() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractMethodBody",
                    String.class, String.class);
            m.setAccessible(true);

            String source = """
                    public class Service {
                        private void helper() { }

                        public String doStuff(int n) {
                            if (n > 0) {
                                return "positive";
                            } else {
                                return "non-positive";
                            }
                        }

                        public void other() { }
                    }
                    """;

            String result = (String) m.invoke(null, source, "doStuff");

            assertThat(result).contains("public String doStuff(int n)");
            assertThat(result).contains("return \"positive\"");
            assertThat(result).contains("return \"non-positive\"");
        }

        @Test
        @DisplayName("returns '// method not found: xxx' for empty source")
        void returnsMethodNotFoundForEmptySource() throws Exception {
            Method m = FixFlowRunner.class.getDeclaredMethod("extractMethodBody",
                    String.class, String.class);
            m.setAccessible(true);

            String result = (String) m.invoke(null, "", "anyMethod");

            assertThat(result).isEqualTo("// method not found: anyMethod");
        }
    }

    // ===================================================================
    // Edge-case tests
    // ===================================================================

    @Nested
    @DisplayName("Edge cases")
    class EdgeCases {

        @Test
        @DisplayName("chatSessionId '0' -> runs successfully, status SUCCESS")
        void chatSessionIdZero() {
            FixSession s = session("9000", "0", "fix/9000-a");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS");
        }

        @Test
        @DisplayName("non-numeric chatSessionId -> runs successfully, status SUCCESS")
        void nonNumericChatSessionId() {
            FixSession s = session("9001", "abc", "fix/9001-a");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS");
        }

        @Test
        @DisplayName("step 1 log analysis is invoked")
        void step1LogAnalysisInvoked() {
            FixSession s = session("600", "48", "fix/600-a");
            setupHappyPath(s);

            runner.run(s);

            try {
                verify(logOrch).analyzeLog(anyString(), any(), anyString(), any(), any());
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }

        @Test
        @DisplayName("missing signature -> status MISSING_SIGNATURE, flow aborted at step 4")
        void missingSignatureAbortsFlow() {
            FixSession s = session("5000", "47", "fix/5000-a");
            s.setThrowPointSig(null);
            setupReport("5000");
            try {
                when(logOrch.analyzeLog(anyString(), any(), anyString(), any(), any()))
                        .thenReturn(null);
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
            System.setProperty("hisi.fix.repo-path", "/repo");
            when(wtSvc.currentBranch("/repo")).thenReturn("master");
            when(wtSvc.createWorktree(anyString(), anyString(), anyString()))
                    .thenReturn("/tmp/wt5000");

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("MISSING_SIGNATURE");
        }

        @Test
        @DisplayName("unexpected exception in flow -> status ERROR")
        void unexpectedExceptionSetsError() {
            FixSession s = session("9999", "51", "fix/9999-e");
            s.setErrorMsg("err");
            setupReport("9999");
            try {
                when(logOrch.analyzeLog(anyString(), any(), anyString(), any(), any()))
                        .thenThrow(new RuntimeException("crash"));
            } catch (Exception e) {
                throw new RuntimeException(e);
            }

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("ERROR");
        }
    }

    // ===================================================================
    // HITL gate tests
    // ===================================================================

    @Nested
    @DisplayName("HITL gate")
    class HitlGateTests {

        private final java.util.List<com.huawei.hisi.ram.model.AgentEvent> hitlEvents = new java.util.ArrayList<>();

        @BeforeEach
        void setUp() {
            hitlEvents.clear();
            when(evtRepo.append(any())).thenAnswer(inv -> {
                com.huawei.hisi.ram.model.AgentEvent e = inv.getArgument(0);
                hitlEvents.add(e);
                return e;
            });
            when(evtRepo.findBySessionId(anyLong())).thenReturn(hitlEvents);
        }

        /**
         * Create a session with hitlEnabled=true and set up happy-path stubs.
         */
        private FixSession hitlSession(String id, String chatId, String branch) {
            FixSession s = session(id, chatId, branch);
            s.setHitlEnabled(true);
            return s;
        }

        @Test
        @DisplayName("hitlEnabled=false runs all 9 steps normally")
        void hitlDisabledRunsAllSteps() {
            FixSession s = session("300", "200", "fix/h1");
            s.setHitlEnabled(false);
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS");
            assertThat(captor.getValue().getCurrentStep()).isNull();
        }

        @Test
        @DisplayName("hitlEnabled=true parks after step 4 (generate_test) with WAITING_HITL")
        void parksAfterStep4() {
            FixSession s = hitlSession("301", "201", "fix/h2");
            setupHappyPath(s);

            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            FixSession last = captor.getValue();
            assertThat(last.getStatus()).isEqualTo("WAITING_HITL");
            assertThat(last.getCurrentStep()).isEqualTo("generate_test");
        }

        @Test
        @DisplayName("hitlEnabled=true parks after step 6 (ai_fix) once step 4 is confirmed")
        void parksAfterStep6WhenStep4Confirmed() {
            FixSession s = hitlSession("302", "202", "fix/h3");
            setupHappyPath(s);

            // First run: parks at step 4
            runner.run(s);

            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");
            assertThat(s.getCurrentStep()).isEqualTo("generate_test");

            // Confirm step 4
            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "approve", null, null);

            // Second run: should park at step 6
            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            FixSession last = captor.getValue();
            assertThat(last.getStatus()).isEqualTo("WAITING_HITL");
            assertThat(last.getCurrentStep()).isEqualTo("ai_fix");
        }

        @Test
        @DisplayName("confirmAndResume with approve advances step and resumes to SUCCESS")
        void confirmApproveAdvancesAndCompletes() {
            FixSession s = hitlSession("303", "203", "fix/h4");
            setupHappyPath(s);

            // Park at step 4
            runner.run(s);
            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");

            // Confirm step 4
            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "approve", null, null);

            // Run to park at step 6
            runner.run(s);
            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");
            assertThat(s.getCurrentStep()).isEqualTo("ai_fix");

            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "approve", null, null);

            // Final run: should complete
            runner.run(s);

            ArgumentCaptor<FixSession> captor = ArgumentCaptor.forClass(FixSession.class);
            verify(fixRepo, atLeastOnce()).update(captor.capture());
            assertThat(captor.getValue().getStatus()).isEqualTo("SUCCESS");
            assertThat(captor.getValue().getCurrentStep()).isNull();
        }

        @Test
        @DisplayName("confirmAndResume with reject keeps currentStep, re-executes gated step")
        void confirmRejectReexecutes() {
            FixSession s = hitlSession("304", "204", "fix/h5");
            setupHappyPath(s);

            // Park at step 4
            runner.run(s);
            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");

            // Reject with feedback
            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "reject", "bad test", null);
            // confirmAndResume updates session with hitlFeedback and keeps currentStep
            // The cached step output is invalidated (no HITL_RES approved found)
            assertThat(s.getCurrentStep()).isEqualTo("generate_test"); // not advanced

            // When run() is called again, it re-executes step 4 (no cached output with approved HITL_RES)
        }

        @Test
        @DisplayName("confirmAndResume with edit saves edited output and advances")
        void confirmEditSavesEditedOutput() {
            FixSession s = hitlSession("305", "205", "fix/h6");
            setupHappyPath(s);

            // Park at step 4
            runner.run(s);
            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");

            // Edit the output
            Map<String, Object> edited = Map.of("testClass", "com.foo.EditedTest");
            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "edit", null, edited);
            assertThat(s.getCurrentStep()).isEqualTo("run_repro"); // advanced
        }

        @Test
        @DisplayName("confirmAndResume on non-WAITING_HITL session throws")
        void confirmWrongStatusThrows() {
            FixSession s = session("306", "206", "fix/h7");
            s.setStatus("RUNNING");
            when(fixRepo.findById("fix-306")).thenReturn(java.util.Optional.of(s));

            assertThatThrownBy(() -> runner.confirmAndResume("fix-306", "approve", null, null))
                    .isInstanceOf(IllegalStateException.class)
                    .hasMessageContaining("not WAITING_HITL");
        }

        @Test
        @DisplayName("confirmAndResume on missing session throws")
        void confirmMissingSessionThrows() {
            when(fixRepo.findById("nonexistent")).thenReturn(java.util.Optional.empty());

            assertThatThrownBy(() -> runner.confirmAndResume("nonexistent", "approve", null, null))
                    .isInstanceOf(IllegalArgumentException.class)
                    .hasMessageContaining("FixSession not found");
        }

        @Test
        @DisplayName("step output is cached and reused on HITL resume")
        void stepOutputCachedOnResume() {
            FixSession s = hitlSession("307", "207", "fix/h8");
            setupHappyPath(s);

            // First run: park at step 4
            runner.run(s);
            assertThat(s.getStatus()).isEqualTo("WAITING_HITL");
            assertThat(s.getCurrentStep()).isEqualTo("generate_test");

            // Verify HITL_REQ event was appended
            verify(evtRepo, atLeastOnce()).append(argThat(
                    e -> e.getType() == EventType.HITL_REQ));

            // Confirm step 4
            when(fixRepo.findById(s.getId())).thenReturn(java.util.Optional.of(s));
            runner.confirmAndResume(s.getId(), "approve", null, null);

            // Second run: step 4 should be cached (no re-generation)
            // To verify, reset the testGenService mock so we can check it's NOT called
            reset(tgSvc);
            when(tgSvc.generate(any(TestGenInput.class), any()))
                    .thenAnswer(inv -> {
                        throw new AssertionError("step 4 should not re-execute on HITL resume");
                    });
            // But we still need repro service for step 5
            when(repSvc.runAndCheckRepro(anyString(), anyString(), anyString(), any(), anyInt()))
                    .thenReturn(true);

            runner.run(s);
            // Should NOT throw AssertionError — step 4 was cached
        }
    }
}
