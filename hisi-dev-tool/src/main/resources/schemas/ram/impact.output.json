{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Impact Stage Output",
  "type": "object",
  "required": ["involved", "modified", "impacted", "risk", "validation"],
  "properties": {
    "involved": {
      "type": "object",
      "required": ["seeds", "entries", "impls"],
      "properties": {
        "seeds":   { "type": "array", "items": {} },
        "entries": { "type": "array", "items": {} },
        "impls":   { "type": "array", "items": {} }
      },
      "additionalProperties": true
    },
    "modified": {
      "type": "object",
      "required": ["tree"],
      "properties": {
        "tree": { "type": "array", "items": {} }
      },
      "additionalProperties": true
    },
    "impacted": {
      "type": "object",
      "required": ["upstream", "downstream", "crossService", "bridges"],
      "properties": {
        "upstream":     { "type": "array", "items": {} },
        "downstream":   { "type": "array", "items": {} },
        "crossService": { "type": "array", "items": {} },
        "bridges":      { "type": "array", "items": {} }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": ["score", "level"],
      "properties": {
        "score": { "type": "number" },
        "level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["passed", "violations"],
      "properties": {
        "passed":     { "type": "boolean" },
        "violations": { "type": "array", "items": {} }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
