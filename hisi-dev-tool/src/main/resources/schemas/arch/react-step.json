{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arch ReAct Agent Step Output",
  "type": "object",
  "required": ["thought"],
  "definitions": {
    "issue": {
      "type": "object",
      "required": ["ref", "title", "severity", "rootCause", "evidenceRefs", "suggestion", "verdict", "reason"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "rootCause": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestion": { "type": "string", "minLength": 1 },
        "verdict": { "type": "string", "enum": ["confirmed", "false_positive", "downgraded"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "view": {
      "type": "object",
      "required": ["insight"],
      "properties": {
        "insight": { "type": "string", "minLength": 1 },
        "diagramRefs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "roadmapItem": {
      "type": "object",
      "required": ["action", "impact"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "benefit": { "type": "string" },
        "risk": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "thought": { "type": "string", "minLength": 1 },
    "action": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "args": { "type": "object" }
      },
      "additionalProperties": true
    },
    "final_answer": {
      "type": "object",
      "required": ["issues", "report"],
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/issue" }
        },
        "report": {
          "type": "object",
          "required": ["executive_summary", "views", "roadmap"],
          "properties": {
            "executive_summary": { "type": "string", "minLength": 1 },
            "views": {
              "type": "object",
              "required": ["logical", "process", "development", "physical", "scenario"],
              "properties": {
                "logical": { "$ref": "#/definitions/view" },
                "process": { "$ref": "#/definitions/view" },
                "development": { "$ref": "#/definitions/view" },
                "physical": { "$ref": "#/definitions/view" },
                "scenario": { "$ref": "#/definitions/view" }
              },
              "additionalProperties": true
            },
            "roadmap": {
              "type": "object",
              "required": ["p0", "p1", "p2"],
              "properties": {
                "p0": { "type": "array", "items": { "$ref": "#/definitions/roadmapItem" } },
                "p1": { "type": "array", "items": { "$ref": "#/definitions/roadmapItem" } },
                "p2": { "type": "array", "items": { "$ref": "#/definitions/roadmapItem" } }
              },
              "additionalProperties": true
            },
            "evidence_appendix": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
