<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.huawei.hisi</groupId>
    <artifactId>hisi-otel-extension</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
      OpenTelemetry Java Agent 2.x 扩展模块：
        * 通过 ByteBuddy advice 捕获被 OTEL_INSTRUMENTATION_METHODS_INCLUDE 命中的方法
          的入参/出参，并以 code.input.N / code.output 形式写入当前 Span 属性。
        * 该扩展被打成 shaded JAR,经 OTEL_JAVAAGENT_EXTENSIONS 环境变量加载。
        * 仅在 OTEL_INSTRUMENTATION_METHODS_INCLUDE 非空时生效;命中的目标类列表由
          KgMethodIncludeBuilder 在 Java 后端构建后注入到目标进程环境变量中。
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <otel.javaagent.version>2.9.0</otel.javaagent.version>
        <bytebuddy.version>1.14.18</bytebuddy.version>
    </properties>

    <dependencies>
        <!-- OTel agent extension API (provided by the running agent) -->
        <dependency>
            <groupId>io.opentelemetry.javaagent</groupId>
            <artifactId>opentelemetry-javaagent-extension-api</artifactId>
            <version>${otel.javaagent.version}-alpha</version>
            <scope>provided</scope>
        </dependency>
        <!-- OTel API (provided by agent shaded classloader) -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.42.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- ByteBuddy (also provided by agent) -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- AutoService for SPI generation (optional, we register manually) -->
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
            <version>1.1.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
