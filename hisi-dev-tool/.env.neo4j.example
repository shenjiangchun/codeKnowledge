# Neo4j 环境变量配置
# 使用方法: 复制此文件为 .env.neo4j 并修改相应值
#
# 步骤:
# 1. 复制本文件: cp .env.neo4j.example .env.neo4j (Linux/Mac)
#    或: copy .env.neo4j.example .env.neo4j (Windows)
# 2. 修改 NEO4J_PASSWORD 为您自己的安全密码
# 3. 确保密码与 docker-compose.neo4j.yml 中的初始密码一致

# Neo4j 认证密码
# 请将下面的占位符替换为您的实际密码
NEO4J_PASSWORD=your_password_here

# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# 数据库名称
NEO4J_DATABASE=neo4j

# 向量维度配置
NEO4J_VECTOR_DIMENSIONS=384
